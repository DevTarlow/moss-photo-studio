# Copy this file to .env and paste a Meta Muse key.
#
# The lab in scripts/lab reads MOSS_LAB_MUSE_KEY. The shipped app never reads
# this file and keeps its key in the system keyring, as before.
#
# .env is gitignored. Never commit a real key.

MOSS_LAB_MUSE_KEY=

# Optional. Hard stop for a single lab run, in cents. Default 300 ($3.00).
MOSS_LAB_MAX_CENTS=300

# Optional. Override the Muse base URL, e.g. to point the lab at a fake host
# for a smoke test. The key would be sent to that host.
# MOSS_LAB_BASE_URL=https://api.meta.ai/v1
